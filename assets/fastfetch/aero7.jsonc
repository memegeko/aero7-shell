{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/aero7-logo.txt",
    "color": {
      "1": "light_red",
      "2": "light_green",
      "3": "light_blue",
      "4": "light_yellow",
      "5": "light_cyan"
    },
    "padding": {
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "light_cyan",
      "title": "light_blue"
    }
  },
  "modules": [
    {
      "type": "title",
      "key": "Aero7 Open Project"
    },
    {
      "type": "custom",
      "key": "Edition",
      "format": "Aero7 Beta 1"
    },
    "os",
    "de",
    "wm",
    "kernel",
    "host",
    "cpu",
    "gpu",
    "memory",
    "display",
    "packages",
    "shell",
    "terminal",
    {
      "type": "custom",
      "key": "Notice",
      "format": "Independent open-source operating system"
    }
  ]
}
